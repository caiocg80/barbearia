  if (v === 'semana') estado.semana    = q === 'hoje' ? inicioSemana(hoje()) : somaDias(estado.semana, 7 * passo);
  if (v === 'mes') {
    if (q === 'hoje') { const n = new Date(); estado.mes = { a: n.getFullYear(), m: n.getMonth() }; }
    else { const d = new Date(estado.mes.a, estado.mes.m + passo, 1); estado.mes = { a: d.getFullYear(), m: d.getMonth() }; }
  }
  VIEWS[v].carregar(false);
});
$('#agenda-data').addEventListener('change', e => { if (e.target.value) { estado.diaAgenda = e.target.value; carregarAgenda(false); } });
$('#dia-data').addEventListener('change', e => { if (e.target.value) { estado.diaHist = e.target.value; carregarDia(false); } });

function abrirDia(dia){ estado.diaHist = dia; ir('dia'); }
document.addEventListener('click', e => {
  const b = e.target.closest('.barra[data-dia]');
  if (b) abrirDia(b.dataset.dia);
});

/* =====================================================
   AGENDA
   ===================================================== */
const carregandoHTML = '<li class="carregando">Carregando…</li>';
const erroHTML = msg => `<li class="erro-lista">Não foi possível carregar: ${esc(msg)}</li>`;

async function carregarAgenda(silencioso){
  const meu = ++seq;
  const dia = estado.diaAgenda;
  $('#agenda-data').value = dia;
  $('#agenda-titulo').innerHTML = esc(fmtLongo(dia)) + (dia === hoje() ? '<span class="tag-hoje">Hoje</span>' : '');
  if (!silencioso) {
    estado.confirmandoId = null;
    $('#agenda-lista').innerHTML = carregandoHTML;
    $('#agenda-prox').innerHTML = '';
    $('#agenda-livres').innerHTML = '';
  }

  const antes = new Map(estado.agenda.map(l => [String(l.id), l.status]));
  const mesmoDia = estado.diaCarregado === dia;

  const { data, error } = await buscar(dia, somaDias(dia, 1));
  if (meu !== seq) return;
  if (error) {
    // Numa atualização automática, mantém o que já está na tela em vez de apagar a lista.
    if (!silencioso) $('#agenda-lista').innerHTML = erroHTML(error.message);
    return;
  }
  estado.agenda = data.map(normalizar);
  estado.diaCarregado = dia;
  renderAgenda();
  if (silencioso && mesmoDia) avisarMudancas(antes);
}

// Avisa quando chega um agendamento novo ou um cliente cancela enquanto o painel está aberto
function avisarMudancas(antes){
  const novos = estado.agenda.filter(l => !antes.has(String(l.id)) && l.status !== 'cancelado');
  const cancelados = estado.agenda.filter(l => {
    const anterior = antes.get(String(l.id));
    return anterior && anterior !== 'cancelado' && l.status === 'cancelado';
  });
  const partes = [];
  if (novos.length === 1) partes.push(`Novo agendamento: ${novos[0].nome} às ${novos[0].hora}.`);
  else if (novos.length > 1) partes.push(`${novos.length} novos agendamentos.`);
  if (cancelados.length === 1) partes.push(`${cancelados[0].nome} cancelou o horário das ${cancelados[0].hora}.`);
  else if (cancelados.length > 1) partes.push(`${cancelados.length} horários foram cancelados.`);
  if (partes.length) aviso(partes.join(' '), 7000);
}

// Pendente que já passou do horário (o corte deveria ter acabado)
function passouDoHorario(l){
  const h = hoje();
  if (l.dia < h) return true;
  if (l.dia > h) return false;
  return minDe(agoraHM()) >= minDe(l.hora) + INTERVALO_MINUTOS;
}

function renderAgenda(){
  const todas = estado.agenda;
  const ativas = todas.filter(l => l.status !== 'cancelado');
  const cont = {
    todos: ativas.length,
    pendente: ativas.filter(l => l.status === 'pendente').length,
    concluido: ativas.filter(l => l.status === 'concluido').length
  };
  $$('#agenda-filtros .filtro').forEach(b => {
    b.setAttribute('aria-pressed', String(b.dataset.filtro === estado.filtro));
    $('b', b).textContent = cont[b.dataset.filtro];
  });

  renderLateral();

  const visiveis = estado.filtro === 'todos' ? todas : todas.filter(l => l.status === estado.filtro);
  const ul = $('#agenda-lista');
  if (!visiveis.length) {
    const txt = estado.filtro === 'pendente' ? 'Nenhum horário pendente neste dia.'
              : estado.filtro === 'concluido' ? 'Nenhum corte concluído neste dia.'
              : 'Nenhum horário marcado neste dia.';
    ul.innerHTML = `<li class="vazio">${txt}</li>`;
    return;
  }
  ul.innerHTML = visiveis.map(itemAgenda).join('');
}

// Cartão do próximo cliente + horários livres do dia
function renderLateral(){
  const dia = estado.diaAgenda;
  const h = hoje();
  const ativas = estado.agenda.filter(l => l.status !== 'cancelado');
  const pendentes = ativas.filter(l => l.status === 'pendente');
  const agora = minDe(agoraHM());

  // Próximo cliente
  let prox = null, rotulo = '', quando = '';
  if (dia === h) {
    prox = pendentes.find(l => minDe(l.hora) >= agora);
    rotulo = 'Próximo cliente';
    if (prox) {
      const falta = minDe(prox.hora) - agora;
      quando = falta === 0 ? 'agora'
             : falta < 60 ? `em ${falta} min`
             : `em ${Math.floor(falta / 60)}h${pad(falta % 60)}`;
    }
  } else if (dia > h) {
    prox = pendentes[0];
    rotulo = 'Primeiro cliente do dia';
  }

  if (prox) {
    const zap = linkZap(prox.zap);
    $('#agenda-prox').innerHTML =
      `<div class="cartao prox"><span class="prox-rot">${rotulo}</span>` +
      `<div class="prox-linha"><span class="prox-hora">${esc(prox.hora)}</span>` +
      `<div class="prox-info"><span class="prox-nome">${esc(prox.nome)}</span>` +
      (quando ? `<span class="prox-quando">${quando}</span>` : '') + '</div></div>' +
      (zap ? `<a class="zap" href="${zap}" target="_blank" rel="noopener">${esc(fmtZap(prox.zap))}</a>` : '') +
      '</div>';
  } else {
    $('#agenda-prox').innerHTML = '';
  }

  // Horários livres (só para hoje e dias futuros em que a barbearia abre)
  if (dia >= h && dataDe(dia).getDay() !== DIA_FECHADO) {
    const ocupados = new Set(ativas.map(l => l.hora));
    const livres = horariosDoDia().filter(s => !ocupados.has(s) && (dia > h || minDe(s) > agora));
    $('#agenda-livres').innerHTML =
      `<div class="cartao"><h2 class="secao-titulo">Horários livres<span class="qtd">${livres.length}</span></h2>` +
      (livres.length
        ? `<div class="chips">${livres.map(s => `<span class="chip">${s}</span>`).join('')}</div>`
        : '<p class="sem-livres">Nenhum horário livre neste dia.</p>') +
      '</div>';
  } else {
    $('#agenda-livres').innerHTML = '';
  }
}

function blocoNome(l){
  const zap = linkZap(l.zap);
  return `<div class="info"><span class="nome">${esc(l.nome)}</span>` +
    (zap ? `<a class="zap" href="${zap}" target="_blank" rel="noopener">${esc(fmtZap(l.zap))}</a>` : '') + '</div>';
}

// Link do WhatsApp com a mensagem de lembrete já escrita
function linkLembrete(l){
  const base = linkZap(l.zap);
  if (!base) return '';
  const primeiro = l.nome === 'Sem nome' ? '' : String(l.nome).trim().split(/\s+/)[0];
  const h = hoje();
  const quando = l.dia === h ? 'hoje' : l.dia === somaDias(h, 1) ? 'amanhã' : `no dia ${fmtCurto(l.dia)}`;
  const texto = `Olá${primeiro ? ', ' + primeiro : ''}! Passando para lembrar do seu horário na barbearia ${quando} às ${l.hora}. Até lá!`;
  return `${base}?text=${encodeURIComponent(texto)}`;
}

function itemAgenda(l){
  const atrasado = l.status === 'pendente' && passouDoHorario(l);
  const id = esc(l.id);
  let acao = '';
  if (l.status === 'pendente') {
    if (String(estado.confirmandoId) === String(l.id)) {
      acao = '<span class="pergunta">Cancelar este horário?</span>' +
        `<button class="btn btn-peq btn-perigo" type="button" data-acao="cancelar-sim" data-id="${id}">Sim, cancelar</button>` +
        `<button class="btn-sec btn-peq" type="button" data-acao="cancelar-nao" data-id="${id}">Manter</button>`;
    } else {
      const lembrete = atrasado ? '' : linkLembrete(l);
      acao = (atrasado ? '<span class="pill alerta">Já passou</span>' : '') +
        (lembrete ? `<a class="btn-sec btn-peq" href="${lembrete}" target="_blank" rel="noopener">Lembrar</a>` : '') +
        `<button class="btn btn-peq" type="button" data-acao="concluir" data-id="${id}">Concluir corte</button>` +
        `<button class="btn-link btn-cancelar" type="button" data-acao="cancelar" data-id="${id}">Cancelar</button>`;
    }
  } else if (l.status === 'concluido') {
    acao = `<span class="pill ok">Concluído</span><button class="btn-link" type="button" data-acao="desfazer" data-id="${id}">Desfazer</button>`;
  } else {
    acao = '<span class="pill mudo">Cancelado</span>';
  }
  return `<li class="item ${l.status}${atrasado ? ' atrasado' : ''}"><div class="hora">${esc(l.hora)}</div>${blocoNome(l)}<div class="acao">${acao}</div></li>`;
}
function itemFeito(l){
  return `<li class="item concluido"><div class="hora">${esc(l.hora)}</div>${blocoNome(l)}</li>`;
}

$('#agenda-filtros').addEventListener('click', e => {
  const b = e.target.closest('.filtro');
  if (!b) return;
  estado.filtro = b.dataset.filtro;
  renderAgenda();
});

$('#agenda-lista').addEventListener('click', async e => {
  const b = e.target.closest('[data-acao]');
  if (!b) return;
  const linha = estado.agenda.find(l => String(l.id) === b.dataset.id);
  if (!linha) return;
  const acao = b.dataset.acao;

  // Cancelar pede confirmação antes (evita toque sem querer)
  if (acao === 'cancelar')      { estado.confirmandoId = linha.id; renderAgenda(); return; }
  if (acao === 'cancelar-nao')  { estado.confirmandoId = null; renderAgenda(); return; }

  let novo;
  if (acao === 'concluir') novo = 'concluido';
  else if (acao === 'desfazer') novo = 'pendente';
  else if (acao === 'cancelar-sim') novo = 'cancelado';
  else return;

  const gravar = novo === 'concluido' ? STATUS_CONCLUIDO : novo === 'cancelado' ? STATUS_CANCELADO : STATUS_PENDENTE;
  const anterior = linha.status;
  estado.confirmandoId = null;
  linha.status = novo;
  renderAgenda();
  const { error } = await db.from(TABELA)
    .update({ status: gravar })
    .eq('id', linha.id);
  if (error) {
    linha.status = anterior;
    renderAgenda();
    aviso('Não foi possível salvar: ' + error.message);
  } else {
    aviso(novo === 'concluido' ? 'Corte marcado como concluído.'
        : novo === 'cancelado' ? 'Horário cancelado. Ele já pode ser marcado por outro cliente.'
        : 'Voltou para pendente.');
  }
});

/* =====================================================
   HISTÓRICO — componentes
   ===================================================== */
function barrasHTML(itens, compacto){
  const max = Math.max(1, ...itens.map(i => i.valor));
  const corpo = itens.map(i => {
    const titulo = `${i.valor} ${plural(i.valor, 'corte', 'cortes')} em ${fmtCurto(i.dia)}`;
    return `<button type="button" class="barra${i.valor ? ' tem' : ''}${i.ativo ? ' ativo' : ''}" data-dia="${i.dia}" title="${titulo}" aria-label="${titulo}">` +
      `<span class="n">${i.valor || ''}</span>` +
      `<span class="area"><span class="col" style="height:${Math.round(i.valor / max * 100)}%"></span></span>` +
      `<span class="r">${esc(i.rotulo)}</span></button>`;
  }).join('');
  return `<div class="barras${compacto ? ' compacto' : ''}" style="--n:${itens.length}">${corpo}</div>`;
}
function resumoHTML(pares){
  return '<dl class="resumo">' + pares.map(([r, v, pequeno]) =>
    `<div><dt>${esc(r)}</dt><dd>${esc(v)}${pequeno ? `<small>${esc(pequeno)}</small>` : ''}</dd></div>`).join('') + '</dl>';
}
function listaAgrupadaHTML(porDia){
  const dias = Array.from(porDia.keys()).sort();
  if (!dias.length) return '<p class="vazio">Nenhum corte concluído neste período.</p>';
  return dias.map(d => {
    const l = porDia.get(d);
    return `<h3 class="grupo-dia">${esc(fmtDiaCurto(d))}<span>${l.length} ${plural(l.length, 'corte', 'cortes')}</span></h3>` +
      `<ul class="lista">${l.map(itemFeito).join('')}</ul>`;
  }).join('');
}
function avisoPendentes(todas){
  const n = todas.filter(l => l.status === 'pendente' && l.dia <= hoje()).length;
  if (!n) return '';
  return `<p class="aviso">${n} ${plural(n, 'agendamento deste período ainda está', 'agendamentos deste período ainda estão')} como pendente${n === 1 ? '' : 's'}. Marque como concluído na Agenda para entrar no histórico.</p>`;
}
function melhorDia(porDia){
  let melhor = null;
  porDia.forEach((l, d) => { if (!melhor || l.length > melhor.n || (l.length === melhor.n && d < melhor.d)) melhor = { d, n: l.length }; });
  return melhor;
}
function erroCorpo(sel, msg){ $(sel).innerHTML = `<p class="erro-lista">Não foi possível carregar: ${esc(msg)}</p>`; }

/* =====================================================
   HISTÓRICO — diário
   ===================================================== */
async function carregarDia(silencioso){
  const meu = ++seq;
  const dia = estado.diaHist;
  $('#dia-data').value = dia;
  $('#dia-sub').textContent = fmtLongo(dia) + (dia === hoje() ? ' (hoje)' : '');
  if (!silencioso) $('#dia-corpo').innerHTML = '<p class="carregando">Carregando…</p>';

  const ini = somaDias(dia, -13);
  const { data, error } = await buscar(ini, somaDias(dia, 1));
  if (meu !== seq) return;
  if (error) return erroCorpo('#dia-corpo', error.message);

  const todas = data.map(normalizar);
  const feitos = todas.filter(l => l.status === 'concluido');
  const por = agruparPorDia(feitos);
  const doDia = por.get(dia) || [];

  const itens = [];
  for (let i = 0; i < 14; i++) {
    const d = somaDias(ini, i);
    itens.push({ dia: d, valor: (por.get(d) || []).length, rotulo: d.slice(8, 10), ativo: d === dia });
  }

  const resumo = resumoHTML([
    ['Cortes no dia', String(doDia.length)],
    ['Primeiro', doDia.length ? doDia[0].hora : '—'],
    ['Último', doDia.length ? doDia[doDia.length - 1].hora : '—']
  ]);
  const pend = avisoPendentes(todas.filter(l => l.dia === dia));
  const lista = doDia.length
    ? `<ul class="lista">${doDia.map(itemFeito).join('')}</ul>`
    : '<p class="vazio">Nenhum corte concluído neste dia.</p>';

  $('#dia-corpo').innerHTML =
    resumo + pend +
    `<div class="grafico"><h2>Últimos 14 dias</h2>${barrasHTML(itens, false)}</div>` +
    lista;
}

/* =====================================================
   HISTÓRICO — semanal
   ===================================================== */
async function carregarSemana(silencioso){
  const meu = ++seq;
  const ini = estado.semana, fim = somaDias(ini, 7);
  const atual = ini === inicioSemana(hoje());
  $('#semana-rotulo').textContent = `${fmtCurto(ini)} a ${fmtCurto(somaDias(ini, 6))}`;
  $('#semana-rotulo').title = atual ? 'Esta semana' : '';
  if (!silencioso) $('#semana-corpo').innerHTML = '<p class="carregando">Carregando…</p>';

  const { data, error } = await buscar(ini, fim);
  if (meu !== seq) return;
  if (error) return erroCorpo('#semana-corpo', error.message);

  const todas = data.map(normalizar);
  const feitos = todas.filter(l => l.status === 'concluido');
  const por = agruparPorDia(feitos);

  const itens = [];
  for (let i = 0; i < 7; i++) {
    const d = somaDias(ini, i);
    itens.push({ dia: d, valor: (por.get(d) || []).length, rotulo: DIAS_ABREV[i], ativo: d === hoje() });
  }
  const diasCom = por.size;
  const media = diasCom ? (feitos.length / diasCom).toFixed(1).replace('.', ',') : '—';
  const melhor = melhorDia(por);

  $('#semana-corpo').innerHTML =
    resumoHTML([
      ['Cortes na semana', String(feitos.length)],
      ['Dias com corte', String(diasCom)],
      ['Média por dia', media],
      ['Melhor dia', melhor ? DIAS_ABREV[idxSemana(melhor.d)] : '—', melhor ? `${melhor.n}` : '']
    ]) +
    avisoPendentes(todas) +
    `<div class="grafico"><h2>Cortes por dia</h2>${barrasHTML(itens, false)}</div>` +
    listaAgrupadaHTML(por);
}

/* =====================================================
   HISTÓRICO — mensal
   ===================================================== */
function semanasDoMes(ano, mes){
  const primeiro = isoDe(new Date(ano, mes, 1));
  const ultimo = isoDe(new Date(ano, mes + 1, 0));
  const res = [];
  let cur = primeiro;
  while (cur <= ultimo) {
    const fimSem = somaDias(inicioSemana(cur), 6);
    const fim = fimSem < ultimo ? fimSem : ultimo;
    res.push({ ini: cur, fim });
    cur = somaDias(fim, 1);
  }
  return res;
}

async function carregarMes(silencioso){
  const meu = ++seq;
  const { a, m } = estado.mes;
  const ini = isoDe(new Date(a, m, 1));
  const fim = isoDe(new Date(a, m + 1, 1));
  const nDias = new Date(a, m + 1, 0).getDate();
  $('#mes-rotulo').textContent = fmtMes(a, m);
  if (!silencioso) $('#mes-corpo').innerHTML = '<p class="carregando">Carregando…</p>';

  const { data, error } = await buscar(ini, fim);
  if (meu !== seq) return;
  if (error) return erroCorpo('#mes-corpo', error.message);

  const todas = data.map(normalizar);
  const feitos = todas.filter(l => l.status === 'concluido');
  const por = agruparPorDia(feitos);

  const itens = [];
  for (let i = 1; i <= nDias; i++) {
    const d = `${a}-${pad(m + 1)}-${pad(i)}`;
    itens.push({ dia: d, valor: (por.get(d) || []).length, rotulo: String(i), ativo: d === hoje() });
  }
  const diasCom = por.size;
  const media = diasCom ? (feitos.length / diasCom).toFixed(1).replace('.', ',') : '—';
  const melhor = melhorDia(por);

  const semanas = semanasDoMes(a, m).map(s => {
    let n = 0;
    for (let d = s.ini; d <= s.fim; d = somaDias(d, 1)) n += (por.get(d) || []).length;
    return { ...s, n };
  });
  const maxSem = Math.max(1, ...semanas.map(s => s.n));
  const semanasHTML = '<div class="semanas">' + semanas.map(s =>
    `<div class="sem-linha"><span>${fmtCurto(s.ini)} a ${fmtCurto(s.fim)}</span>` +
    `<span class="sem-barra"><i style="width:${Math.round(s.n / maxSem * 100)}%"></i></span><b>${s.n}</b></div>`
  ).join('') + '</div>';

  $('#mes-corpo').innerHTML =
    resumoHTML([
      ['Cortes no mês', String(feitos.length)],
      ['Dias com corte', String(diasCom)],
      ['Média por dia', media],
      ['Melhor dia', melhor ? melhor.d.slice(8, 10) + '/' + melhor.d.slice(5, 7) : '—', melhor ? `${melhor.n} ${plural(melhor.n, 'corte', 'cortes')}` : '']
    ]) +
    avisoPendentes(todas) +
    `<div class="grafico"><h2>Cortes por dia</h2>${barrasHTML(itens, true)}</div>` +
    `<h2 class="secao-titulo">Por semana</h2>${semanasHTML}` +
    `<details class="lista-mes"><summary>Ver todos os cortes do mês</summary>${listaAgrupadaHTML(por)}</details>`;
}

/* =====================================================
   INÍCIO
   ===================================================== */
setModo('entrar');
if (recuperando) { $('#tela-login').hidden = false; setModo('nova'); }

})();
