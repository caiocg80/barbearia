<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#1c1917">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Painel do barbeiro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&display=swap">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --carvao:#1c1917;
    --carvao-2:#292524;
    --carvao-3:#3a3431;
    --linha:#44403c;
    --latao:#c8a45c;
    --latao-claro:#e6d3a3;
    --laranja:#f97316;
    --laranja-esc:#c2410c;
    --laranja-claro:#fb923c;
    --texto:#f5f5f4;
    --texto-2:#a8a29e;
    --ok:#8cbf6f;
    --erro:#ec7c66;
    --fonte:'Barlow',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
    --fonte-titulo:'Barlow Condensed','Arial Narrow',var(--fonte);
    color-scheme:dark;
  }
  *{box-sizing:border-box}
  [hidden]{display:none !important}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0;background:var(--carvao);color:var(--texto);
    font-family:var(--fonte);font-size:16px;line-height:1.45;
  }
  button,input{font:inherit;color:inherit}
  a{color:inherit}
  :focus-visible{outline:2px solid var(--latao);outline-offset:2px}

  .faixa{
    height:6px;
    background:repeating-linear-gradient(135deg,var(--laranja) 0 10px,var(--latao) 10px 20px,var(--carvao-3) 20px 30px);
  }

  /* ---------- botões ---------- */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
    background:var(--laranja);color:#1b1917;border:0;border-radius:6px;
    padding:.75rem 1.1rem;font-weight:600;cursor:pointer;
    transition:background .15s;
  }
  .btn:hover{background:var(--laranja-claro)}
  .btn:disabled{opacity:.6;cursor:wait}
  .btn-peq{padding:.5rem .85rem;font-size:.93rem}
  .btn-sec{
    background:transparent;color:var(--texto);border:1px solid var(--linha);
    border-radius:6px;padding:.5rem .8rem;cursor:pointer;
  }
  .btn-sec:hover{border-color:var(--latao);color:var(--latao-claro)}
  a.btn-sec{display:inline-flex;align-items:center;justify-content:center;text-decoration:none}
  .btn-link{
    background:none;border:0;padding:.25rem .1rem;color:var(--latao);cursor:pointer;
    text-decoration:underline;text-underline-offset:3px;
  }
  .btn-link:hover{color:var(--latao-claro)}
  .btn-perigo{background:var(--erro)}
  .btn-perigo:hover{background:#f19483}
  .btn-cancelar{color:var(--erro)}
  .btn-cancelar:hover{color:#f4a595}

  /* ---------- login ---------- */
  .login{
    min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;
    padding:max(20px,env(safe-area-inset-top)) 20px max(20px,env(safe-area-inset-bottom));
    background:radial-gradient(circle at 20% 20%, #2a2320 0%, var(--carvao) 60%);
  }
  .card{
    width:100%;max-width:400px;
    background:linear-gradient(160deg, var(--carvao-2), #211d1b);
    border:1px solid #44403c;border-radius:18px;padding:36px 30px;
    box-shadow:0 20px 50px rgba(0,0,0,.5);position:relative;overflow:hidden;
  }
  .card::before{
    content:"";position:absolute;top:-60px;right:-60px;width:160px;height:160px;
    background:radial-gradient(circle, rgba(249,115,22,.25), transparent 70%);border-radius:50%;
    pointer-events:none;
  }
  .logo{display:flex;flex-direction:column;align-items:center;margin-bottom:24px}
  .logo-icon{
    width:64px;height:64px;border-radius:50%;
    background:linear-gradient(135deg, var(--laranja), var(--laranja-esc));
    display:flex;align-items:center;justify-content:center;font-size:30px;margin-bottom:12px;
    box-shadow:0 8px 20px rgba(249,115,22,.35);
  }
  .logo h1{font-size:20px;letter-spacing:.5px;color:var(--texto);text-align:center;font-weight:600;line-height:1.3}
  .logo span{
    display:block;font-size:12.5px;color:var(--laranja-claro);text-transform:uppercase;
    letter-spacing:1.5px;margin-top:4px;font-weight:400;
  }
  .tabs{
    display:flex;background:var(--carvao);border-radius:12px;padding:4px;margin-bottom:24px;
    border:1px solid #44403c;
  }
  .tab{
    flex:1;text-align:center;padding:10px 0;font-size:14px;font-weight:600;color:var(--texto-2);
    background:none;border:0;border-radius:9px;cursor:pointer;transition:all .2s ease;user-select:none;
  }
  .tab.active{
    background:linear-gradient(135deg, var(--laranja), var(--laranja-esc));color:#fff;
    box-shadow:0 4px 12px rgba(249,115,22,.3);
  }
  .cab-modo{text-align:center;margin-bottom:22px}
  .cab-modo h2{margin:0 0 .3rem;font-size:1.15rem;font-weight:600}
  .cab-modo p{margin:0;color:var(--texto-2);font-size:.93rem}
  #form-login{display:flex;flex-direction:column;gap:16px}
  .campo{display:flex;flex-direction:column;gap:6px}
  .campo label{
    font-size:12.5px;color:var(--texto-2);font-weight:600;text-transform:uppercase;letter-spacing:.5px;
  }
  .campo input{
    width:100%;background:var(--carvao);border:1px solid #57534e;border-radius:10px;
    padding:12px 14px;color:var(--texto);font-size:16px;outline:none;
    transition:border-color .2s ease, box-shadow .2s ease;
  }
  .campo input:focus{border-color:var(--laranja);box-shadow:0 0 0 3px rgba(249,115,22,.15)}
  .entrada{position:relative}
  .entrada input{padding-right:2.9rem}
  .toggle-olho{
    position:absolute;right:6px;top:50%;transform:translateY(-50%);
    background:none;border:0;cursor:pointer;color:var(--texto-2);font-size:16px;padding:8px;line-height:1;
  }
  .card button[type="submit"]{
    margin-top:6px;background:linear-gradient(135deg, var(--laranja), var(--laranja-esc));
    border:none;color:#fff;font-size:15.5px;font-weight:700;padding:13px 0;border-radius:10px;
    cursor:pointer;letter-spacing:.3px;
    transition:transform .15s ease, box-shadow .15s ease, opacity .2s ease;
    box-shadow:0 8px 20px rgba(249,115,22,.3);
  }
  .card button[type="submit"]:hover{transform:translateY(-1px)}
  .card button[type="submit"]:disabled{opacity:.6;cursor:not-allowed;transform:none}
  .msg{
    padding:11px 14px;border-radius:10px;font-size:13.5px;text-align:center;line-height:1.4;
  }
  .msg.erro{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.4);color:#fca5a5}
  .msg.sucesso{background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.4);color:#86efac}
  .login-links{display:flex;justify-content:center;flex-wrap:wrap;gap:.5rem 1.25rem;margin-top:18px;font-size:.93rem}
  .rodape{text-align:center;margin-top:22px;font-size:12px;color:#6b6560}
  .spinner{
    width:16px;height:16px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;
    display:inline-block;animation:girar .7s linear infinite;vertical-align:middle;margin-right:8px;
  }
  @keyframes girar{to{transform:rotate(360deg)}}

  /* ---------- estrutura do app ---------- */
  .app{display:grid;grid-template-columns:15.5rem 1fr;min-height:100vh;min-height:100dvh}
  .lateral{
    position:sticky;top:0;height:100vh;height:100dvh;display:flex;flex-direction:column;
    background:var(--carvao-2);border-right:1px solid var(--linha);
  }
  .marca{padding:1.25rem 1.25rem 1rem;border-bottom:1px solid var(--linha)}
  .marca-nome{display:block;font-family:var(--fonte-titulo);font-weight:700;font-size:1.65rem;line-height:1;color:var(--latao-claro)}
  .marca-sub{display:block;margin-top:.25rem;font-size:.85rem;color:var(--texto-2)}
  .nav{flex:1;overflow-y:auto;padding:.9rem .75rem}
  .nav-grupo{margin:1.25rem .5rem .4rem;font-size:.85rem;color:var(--texto-2)}
  .nav-item{
    display:flex;align-items:center;gap:.75rem;width:100%;text-align:left;
    background:none;border:0;border-left:3px solid transparent;border-radius:0 6px 6px 0;
    padding:.65rem .75rem;color:var(--texto-2);cursor:pointer;
  }
  .nav-item svg{width:20px;height:20px;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  .nav-item:hover{background:var(--carvao-3);color:var(--texto)}
  .nav-item.ativo{background:var(--carvao-3);border-left-color:var(--laranja);color:var(--latao-claro);font-weight:600}
  .lateral-rodape{
    padding:.9rem 1.1rem calc(.9rem + env(safe-area-inset-bottom));
    border-top:1px solid var(--linha);display:flex;flex-direction:column;gap:.5rem;
  }
  .usuario{font-size:.85rem;color:var(--texto-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

  .conteudo{min-width:0;padding:2rem clamp(1rem,3vw,2.5rem) 3rem}
  .topo{
    display:none;align-items:center;gap:.75rem;
    position:sticky;top:0;z-index:10;background:var(--carvao);border-bottom:1px solid var(--linha);
    padding:calc(.6rem + env(safe-area-inset-top)) 1rem .6rem;
  }
  .topo-titulo{font-family:var(--fonte-titulo);font-weight:600;font-size:1.35rem}
  .btn-menu{background:none;border:1px solid var(--linha);border-radius:6px;padding:.4rem;line-height:0;cursor:pointer}
  .btn-menu svg{width:22px;height:22px;stroke:var(--texto);fill:none;stroke-width:2;stroke-linecap:round}
  .fundo-menu{display:none}

  .view{max-width:52rem}
  #view-agenda{max-width:72rem}
  .cabeca{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1.25rem}
  .cabeca h1{font-family:var(--fonte-titulo);font-weight:700;font-size:2.2rem;line-height:1.05;margin:0}
  .cabeca .sub{margin:.2rem 0 0;color:var(--texto-2)}
  .tag-hoje{
    display:inline-block;vertical-align:middle;margin-left:.6rem;padding:.1rem .55rem;border-radius:999px;
    font-family:var(--fonte);font-size:.8rem;font-weight:600;background:var(--laranja);color:#1b1917;
  }
  .navdata{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap}
  .navdata .btn-sec{min-width:2.4rem}
  .navdata input[type=date]{
    background:var(--carvao-2);border:1px solid var(--linha);border-radius:6px;padding:.5rem .6rem;
  }
  .rotulo-periodo{padding:0 .5rem;font-weight:600;min-width:9rem;text-align:center}

  .filtros{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:1.1rem}
  .filtro{
    background:var(--carvao-2);border:1px solid var(--linha);border-radius:999px;
    padding:.4rem .95rem;cursor:pointer;color:var(--texto-2);
  }
  .filtro b{margin-left:.35rem;color:var(--texto)}
  .filtro[aria-pressed=true]{background:var(--laranja);border-color:var(--laranja);color:#1b1917;font-weight:600}
  .filtro[aria-pressed=true] b{color:#1b1917}

  /* ---------- agenda: lista + coluna lateral ---------- */
  .agenda-grade{display:grid;gap:1.1rem}
  .agenda-lateral{display:contents}
  #agenda-prox{order:0}
  .agenda-principal{order:1;min-width:0}
  #agenda-livres{order:2}
  #agenda-prox:empty,#agenda-livres:empty{display:none}

  .cartao{background:var(--carvao-2);border:1px solid var(--linha);border-radius:8px;padding:.9rem 1rem}
  .prox{border-left:3px solid var(--laranja);display:flex;flex-direction:column;gap:.35rem}
  .prox-rot{font-size:.85rem;color:var(--texto-2)}
  .prox-linha{display:flex;align-items:center;gap:.9rem}
  .prox-hora{font-family:var(--fonte-titulo);font-weight:700;font-size:2.4rem;line-height:1;color:var(--latao)}
  .prox-info{display:flex;flex-direction:column;min-width:0}
  .prox-nome{font-weight:600;font-size:1.1rem;overflow:hidden;text-overflow:ellipsis}
  .prox-quando{font-size:.9rem;color:var(--laranja-claro)}
  .chips{display:flex;flex-wrap:wrap;gap:.4rem}
  .chip{
    padding:.2rem .65rem;border:1px solid var(--linha);border-radius:999px;
    font-size:.9rem;font-variant-numeric:tabular-nums;
  }
  .sem-livres{margin:0;color:var(--texto-2);font-size:.93rem}

  @media (min-width:1180px){
    .agenda-grade{grid-template-columns:minmax(0,1fr) 19rem;align-items:start;gap:1.5rem}
    .agenda-lateral{
      display:flex;flex-direction:column;gap:1rem;
      grid-column:2;grid-row:1;position:sticky;top:1.25rem;
    }
    .agenda-principal{grid-column:1;grid-row:1}
  }

  /* ---------- lista ---------- */
  .lista{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.6rem}
  .item{
    display:grid;grid-template-columns:minmax(4.4rem,auto) 1fr auto;align-items:center;gap:.9rem;
    background:var(--carvao-2);border:1px solid var(--linha);border-left:3px solid var(--laranja);
    border-radius:8px;padding:.8rem 1rem;
  }
  .item.concluido{border-left-color:var(--ok)}
  .item.atrasado{border-left-color:var(--latao)}
  .item.cancelado{border-left-color:var(--linha);opacity:.65}
  .item.cancelado .nome{text-decoration:line-through}
  .hora{font-family:var(--fonte-titulo);font-weight:600;font-size:1.7rem;line-height:1;color:var(--latao)}
  .info{display:flex;flex-direction:column;min-width:0}
  .nome{font-weight:600;font-size:1.05rem;overflow:hidden;text-overflow:ellipsis}
  .zap{font-size:.9rem;color:var(--texto-2);text-decoration:none;width:fit-content}
  .zap:hover{color:var(--latao-claro);text-decoration:underline}
  .acao{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;justify-content:flex-end}
  .pergunta{font-size:.93rem;color:var(--texto-2)}
  .pill{font-size:.8rem;font-weight:600;padding:.15rem .6rem;border-radius:999px;border:1px solid}
  .pill.ok{color:var(--ok);border-color:rgba(140,191,111,.55)}
  .pill.mudo{color:var(--texto-2);border-color:var(--linha)}
  .pill.alerta{color:var(--latao-claro);border-color:rgba(200,164,92,.55)}
  .vazio,.carregando,.erro-lista{
    padding:1.6rem 1rem;text-align:center;color:var(--texto-2);
    border:1px dashed var(--linha);border-radius:8px;
  }
  .erro-lista{color:var(--erro);border-color:rgba(236,124,102,.5)}
  .aviso{
    margin:0 0 1.1rem;padding:.65rem .85rem;border-radius:6px;font-size:.93rem;
    background:rgba(200,164,92,.1);border:1px solid rgba(200,164,92,.4);color:var(--latao-claro);
  }

  /* ---------- histórico ---------- */
  .resumo{display:grid;grid-template-columns:repeat(auto-fit,minmax(8.5rem,1fr));gap:.6rem;margin:0 0 1.25rem}
  .resumo div{background:var(--carvao-2);border:1px solid var(--linha);border-radius:8px;padding:.7rem .9rem}
  .resumo dt{font-size:.85rem;color:var(--texto-2);margin:0}
  .resumo dd{margin:.1rem 0 0;font-family:var(--fonte-titulo);font-weight:600;font-size:1.9rem;line-height:1.1;color:var(--latao-claro)}
  .resumo dd small{font-family:var(--fonte);font-size:.85rem;font-weight:400;color:var(--texto-2);margin-left:.25rem}

  .grafico{
    background:var(--carvao-2);border:1px solid var(--linha);border-radius:8px;
    padding:1rem 1rem .6rem;margin-bottom:1.5rem;overflow-x:auto;
  }
  .grafico h2,.secao-titulo{font-size:1rem;font-weight:600;margin:0 0 .8rem;color:var(--texto-2)}
  .secao-titulo .qtd{margin-left:.5rem;color:var(--latao-claro)}
  .barras{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));gap:6px}
  .barras.compacto{grid-template-columns:repeat(var(--n),minmax(22px,1fr));min-width:calc(var(--n) * 26px)}
  .barra{
    display:flex;flex-direction:column;align-items:center;gap:.25rem;height:11rem;
    background:none;border:0;padding:0;cursor:pointer;border-radius:4px;
  }
  .barra:hover .col{filter:brightness(1.15)}
  .barra .n{font-size:.85rem;color:var(--texto);min-height:1.1em}
  .barra .area{flex:1;width:100%;display:flex;align-items:flex-end;justify-content:center}
  .barra .col{width:100%;max-width:2.6rem;min-height:3px;background:var(--linha);border-radius:3px 3px 0 0}
  .barra.tem .col{background:var(--latao)}
  .barra.ativo .col{background:var(--laranja)}
  .barra .r{font-size:.78rem;color:var(--texto-2)}
  .barra.ativo .r{color:var(--laranja);font-weight:600}

  .grupo-dia{
    display:flex;justify-content:space-between;align-items:baseline;gap:1rem;
    margin:1.4rem 0 .5rem;font-size:1.05rem;font-weight:600;
  }
  .grupo-dia span{font-weight:400;font-size:.9rem;color:var(--texto-2)}
  .grupo-dia:first-child{margin-top:0}
  .semanas{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.5rem}
  .sem-linha{display:grid;grid-template-columns:8.5rem 1fr 2.5rem;align-items:center;gap:.8rem;font-size:.95rem}
  .sem-linha b{text-align:right}
  .sem-barra{height:10px;background:var(--carvao-3);border-radius:999px;overflow:hidden}
  .sem-barra i{display:block;height:100%;background:var(--latao);border-radius:999px}
  details.lista-mes{margin-top:.5rem}
  details.lista-mes summary{cursor:pointer;color:var(--latao);margin-bottom:.8rem}

  #toast{
    position:fixed;left:50%;bottom:calc(1.25rem + env(safe-area-inset-bottom));transform:translateX(-50%);
    background:var(--carvao-3);border:1px solid var(--latao);border-radius:8px;padding:.6rem 1rem;
    z-index:50;max-width:90vw;opacity:0;pointer-events:none;transition:opacity .2s;
  }
  #toast.visivel{opacity:1}

  /* ---------- telas estreitas ---------- */
  @media (max-width:860px){
    .app{grid-template-columns:1fr}
    .lateral{
      position:fixed;top:0;bottom:0;left:0;height:auto;width:min(17rem,84vw);z-index:30;
      transform:translateX(-102%);transition:transform .22s ease;
      padding-top:env(safe-area-inset-top);
    }
    .lateral.aberta{transform:none}
    .fundo-menu.aberto{display:block;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:20}
    .topo{display:flex}
    .conteudo{padding-top:1.25rem}
    .cabeca h1{font-size:1.9rem}
    .item{grid-template-columns:minmax(3.6rem,auto) 1fr;row-gap:.5rem}
    .item .acao{grid-column:1 / -1;justify-content:flex-start;gap:.4rem .5rem}
    .item .btn-peq{padding:.5rem .7rem}
    .sem-linha{grid-template-columns:7rem 1fr 2rem}
  }
  @media (prefers-reduced-motion:reduce){
    *{transition:none !important;animation:none !important}
  }
</style>
</head>
<body>

<!-- ======================= LOGIN ======================= -->
<main class="login" id="tela-login" hidden>
  <div class="card">
    <div class="logo">
      <div class="logo-icon">💈</div>
      <h1>Barbearia
        <span>Acesso do Barbeiro</span>
      </h1>
    </div>

    <div class="tabs" id="tabs" role="tablist">
      <button type="button" class="tab active" data-modo="entrar" role="tab">Entrar</button>
      <button type="button" class="tab" data-modo="cadastrar" role="tab">Cadastrar senha</button>
    </div>

    <div class="cab-modo" id="login-cab" hidden>
      <h2 id="login-titulo"></h2>
      <p id="login-sub"></p>
    </div>

    <form id="form-login" novalidate>
      <div class="campo" data-campo="email">
        <label for="f-email">Login (e-mail)</label>
        <input type="email" id="f-email" placeholder="seuemail@exemplo.com" autocomplete="username" inputmode="email" autocapitalize="off" spellcheck="false">
      </div>
      <div class="campo" data-campo="senha">
        <label for="f-senha" id="rot-senha">Senha</label>
        <div class="entrada">
          <input type="password" id="f-senha" placeholder="••••••••" autocomplete="current-password">
          <button type="button" class="toggle-olho" data-alvo="f-senha" aria-label="Mostrar ou ocultar a senha">👁</button>
        </div>
      </div>
      <div class="campo" data-campo="conf">
        <label for="f-conf">Confirmar senha</label>
        <div class="entrada">
          <input type="password" id="f-conf" placeholder="repita a senha" autocomplete="new-password">
